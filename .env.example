# GEMINI_API_KEY: Required for Gemini AI API calls (if enabled).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Firebase Web App Configuration (Add these exact variables in Vercel Project Settings)
VITE_FIREBASE_API_KEY="REPLACE_WITH_FIREBASE_API_KEY"
VITE_FIREBASE_AUTH_DOMAIN="REPLACE_WITH_FIREBASE_AUTH_DOMAIN"
VITE_FIREBASE_PROJECT_ID="REPLACE_WITH_FIREBASE_PROJECT_ID"
VITE_FIREBASE_STORAGE_BUCKET="REPLACE_WITH_FIREBASE_STORAGE_BUCKET"
VITE_FIREBASE_MESSAGING_SENDER_ID="REPLACE_WITH_FIREBASE_MESSAGING_SENDER_ID"
VITE_FIREBASE_APP_ID="REPLACE_WITH_FIREBASE_APP_ID"
VITE_FIREBASE_DATABASE_ID="REPLACE_WITH_FIRESTORE_DATABASE_ID"

# Server-Side Sovereign Secrets (Never expose in client VITE_* variables)
FOUNDER_AUTH_KEY="REPLACE_WITH_FOUNDER_AUTH_KEY"
GOV_OFFICER_CODE="REPLACE_WITH_GOV_OFFICER_CODE"
PANINIAN_SERVER_SALT="REPLACE_WITH_PANINIAN_SERVER_SALT"
